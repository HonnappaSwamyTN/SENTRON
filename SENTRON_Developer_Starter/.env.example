# SENTRON V1 Configuration (Local-Only Environment Variables)
# NOTE: SENTRON V1 operates 100% locally and requires ZERO external AI API keys.
# NEVER place real secrets, API keys, or cloud credentials in this file.

# CrashGuard Monitoring Cadence & Thresholds
SENTRON_SAMPLING_INTERVAL_SECONDS=5
SENTRON_CPU_WARNING_THRESHOLD=85.0
SENTRON_CPU_CRITICAL_THRESHOLD=95.0
SENTRON_MEMORY_WARNING_THRESHOLD=85.0
SENTRON_MEMORY_CRITICAL_THRESHOLD=95.0
SENTRON_SUSTAINED_WINDOW_SECONDS=30
SENTRON_ALERT_COOLDOWN_SECONDS=120

# Core SQLite Storage & Retention
SENTRON_DB_PATH=sentron_events.db
SENTRON_RETENTION_DAYS=30
